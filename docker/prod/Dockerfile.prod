# syntax=docker/dockerfile:1

# ---- Stage 1: Build JS assets ----
FROM node:22-alpine AS assets
WORKDIR /app
ENV WAYFINDER_COMMAND="echo 'wayfinder: skipped in production build'"
COPY laravel/package*.json ./
RUN npm ci
COPY --exclude=node_modules laravel/ ./
RUN npm run build && rm -f public/hot

# ---- Stage 2: PHP production dependencies ----
FROM composer:2 AS vendor
WORKDIR /app
COPY laravel/composer*.json ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction
COPY --exclude=vendor laravel/ ./
RUN composer dump-autoload --optimize --classmap-authoritative

# ---- Stage 3: PHP-FPM runtime ----
FROM php:8.5-fpm-alpine AS php-runtime

RUN apk add --no-cache \
    libzip-dev \
    icu-dev \
    tzdata && \
    docker-php-ext-install \
    pdo_mysql \
    zip \
    intl \
    bcmath

COPY docker/prod/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www/html

COPY --chown=www-data:www-data --from=vendor /app ./
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

RUN rm -f public/hot

RUN mkdir -p storage/framework/{cache,sessions,views} bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY docker/prod/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/entrypoint.sh"]

# ---- Stage 4: Nginx with baked-in static assets ----
FROM nginx:1.27-alpine AS nginx-runtime

COPY --from=php-runtime /var/www/html/public /var/www/html/public
COPY docker/prod/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80